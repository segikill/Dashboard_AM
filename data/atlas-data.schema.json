{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segikill.github.io/Dashboard_AM/data/atlas-data.schema.json",
  "title": "Dashboard_AM analytical data contract",
  "description": "Contract for the fully assembled anonymized mortality, ICD-10, municipality and settlement dataset loaded by the Amur mortality atlas.",
  "type": "object",
  "required": [
    "regionKey",
    "regionName",
    "period",
    "populationYear",
    "populationTotal",
    "years",
    "records",
    "classes",
    "blocks",
    "codes",
    "municipalities",
    "settlements",
    "mapBounds3857",
    "quality"
  ],
  "properties": {
    "regionKey": { "const": "amur" },
    "regionName": { "type": "string", "minLength": 1 },
    "period": { "const": "2023–2025" },
    "populationYear": { "const": 2021 },
    "populationTotal": { "const": 764218 },
    "years": {
      "type": "array",
      "prefixItems": [
        { "const": 2023 },
        { "const": 2024 },
        { "const": 2025 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "records": {
      "type": "array",
      "minItems": 30232,
      "maxItems": 30232,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "integer", "enum": [2023, 2024, 2025] },
          { "type": "integer", "enum": [1, 2] },
          { "type": "integer", "minimum": -1, "maximum": 120 },
          { "type": "integer", "minimum": -1 },
          { "type": "integer", "minimum": -1 },
          { "type": "integer", "minimum": -1 }
        ],
        "minItems": 6,
        "maxItems": 6
      }
    },
    "classes": { "type": "array", "minItems": 22, "maxItems": 22 },
    "blocks": { "type": "array", "minItems": 133, "maxItems": 133 },
    "codes": { "type": "array", "minItems": 577, "maxItems": 577 },
    "municipalities": { "type": "array", "minItems": 29, "maxItems": 29 },
    "settlements": { "type": "array", "minItems": 632, "maxItems": 632 },
    "mapBounds3857": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "quality": { "type": "object" }
  },
  "additionalProperties": true,
  "x-delivery-contract": {
    "schemaVersion": 2,
    "eagerResources": [
      "atlas-reference.js",
      "atlas-observations.js",
      "atlas-data.js"
    ],
    "lazyResources": [
      "atlas-spatial.js"
    ],
    "spatialProjection": "EPSG:3857"
  },
  "x-atlas-contract": {
    "schemaVersion": 1,
    "regionKey": "amur",
    "period": "2023–2025",
    "populationYear": 2021,
    "populationTotal": 764218,
    "years": [2023, 2024, 2025],
    "sexes": [1, 2],
    "maxAge": 120,
    "missingIndex": -1,
    "recordLayout": [
      "year",
      "sex",
      "age",
      "codeIndex",
      "municipalityIndex",
      "settlementIndex"
    ],
    "expectedCounts": {
      "records": 30232,
      "classes": 22,
      "blocks": 133,
      "codes": 577,
      "municipalities": 29,
      "settlements": 632
    },
    "excludedActiveCodes": ["Y35", "Y36"]
  }
}
